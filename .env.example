# Copy to .env and edit before deploying: cp .env.example .env
PORT=4000

# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

SESSION_TTL=12h
OTP_TTL_MS=180000
OFFLINE_AFTER_MS=90000
MAX_UPLOAD_BYTES=524288000

RATE_LIMIT_AUTH=10
RATE_LIMIT_SIGNUP=5

# Object storage (MinIO). The S3 API port is the CDN origin.
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ACCESS_KEY=brandcast
MINIO_SECRET_KEY=brandcast-secret
MINIO_BUCKET=brandcast-media

# Put a CDN in front of MinIO in production, e.g. https://cdn.yourdomain.com
# Screens then fetch media from the edge instead of the origin.
CDN_BASE_URL=

# Appears on generated tax invoices
ISSUER_GSTIN=29AABCB1234C1ZX
