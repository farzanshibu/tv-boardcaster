# Copy to .env and edit before deploying: cp .env.example .env
PORT=4000

# REQUIRED in production: a long random string. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

SESSION_TTL=12h
OTP_TTL_MS=180000
OFFLINE_AFTER_MS=90000
MAX_UPLOAD_BYTES=209715200

RATE_LIMIT_AUTH=10
RATE_LIMIT_SIGNUP=5

# Appears on generated tax invoices
ISSUER_GSTIN=29AABCB1234C1ZX
