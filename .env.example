# Copy to .env and edit before deploying: cp .env.example .env
PORT=4000

# ------- database ----
# Required. `docker compose up -d postgres` gives you this one.
DATABASE_URL=postgres://brandcast:brandcast@localhost:5433/brandcast
POSTGRES_USER=brandcast
POSTGRES_PASSWORD=brandcast
POSTGRES_DB=brandcast
# Host port only; the app reaches Postgres on 5432 inside the compose network.
POSTGRES_PORT=5433
PG_POOL_MAX=10

# ---------- auth ----
# REQUIRED in production. Generate one with:
#   bun -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

SESSION_TTL=12h
OTP_TTL_MS=180000
OFFLINE_AFTER_MS=90000
MAX_UPLOAD_BYTES=524288000

RATE_LIMIT_AUTH=10
RATE_LIMIT_SIGNUP=5

# ----- delivery -----
# Fan-out for publishes across app nodes. Unset means a single-process bus, which
# is correct for one node and wrong for several.
REDIS_URL=
REDIS_PORT=6380
# Or an MQTT broker instead: BUS_DRIVER=mqtt
MQTT_URL=
# Identifies this node in logs and in /api/admin/health. Generated when unset.
NODE_ID=

# ------ storage -----
# Object storage (MinIO). The S3 API port is the CDN origin.
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ACCESS_KEY=brandcast
MINIO_SECRET_KEY=brandcast-secret
MINIO_BUCKET=brandcast-media

# Put a CDN in front of MinIO in production, e.g. https://cdn.yourdomain.com
# Screens then fetch media from the edge instead of the origin.
#   docker compose --profile edge up -d   →   CDN_BASE_URL=http://localhost:9020
CDN_BASE_URL=
EDGE_PORT=9020
# How long the edge may serve a playlist before revalidating. Segments are immutable
# and cached for a year regardless.
CDN_PLAYLIST_MAX_AGE=10

# ---- transcode -----
# Jobs this process runs at once. 0 makes it enqueue-only and leaves the work to
# `bun scripts/transcode-worker.ts` (compose profile `workers`).
TRANSCODE_CONCURRENCY=
WORKER_CONCURRENCY=2
TRANSCODE_MAX_ATTEMPTS=3
# A claim older than this is treated as a dead worker and requeued.
TRANSCODE_LEASE_MS=1200000

# ------ billing -----
# With no keys the service stays on the `manual` gateway: /api/billing/subscribe
# applies the plan directly, which is the self-hosted and demo path.
# With keys, subscribe only opens a hosted checkout and the plan changes when the
# signed webhook arrives at /api/billing/webhooks/{stripe,razorpay}.
BILLING_GATEWAY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: bill Razorpay subscriptions against a plan created in their dashboard.
# RAZORPAY_PLAN_GROWTH_MONTHLY=plan_xxx
# Where the gateway sends the customer back to, and the base for webhook URLs.
PUBLIC_BASE_URL=http://localhost:4000

# Appears on generated tax invoices
ISSUER_GSTIN=29AABCB1234C1ZX
